{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Google Region Monitor standard profiles",
  "type": "object",
  "required": [
    "schemaVersion",
    "profiles"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "updatedAt": {
      "type": "string"
    },
    "profiles": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.-]{1,80}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "interfaceLang": {
            "type": "string"
          },
          "resultLangs": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "region": {
            "type": "string"
          },
          "queries": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "profileGroup": {
            "type": "string",
            "maxLength": 80
          },
          "queryGroups": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": [
                "name",
                "queries"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 100
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "queries": {
                  "type": "array",
                  "maxItems": 500,
                  "items": {
                    "type": "string",
                    "maxLength": 2048
                  }
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
