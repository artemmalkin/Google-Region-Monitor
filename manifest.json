{
  "manifest_version": 3,
  "name": "Google Region Monitor",
  "version": "1.4.2",
  "description": "Управление профилями Google Preferences, возврат к русскому профилю, GitHub-синхронизация и мониторинг выдачи.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "activeTab",
    "tabs",
    "downloads",
    "alarms",
    "windows"
  ],
  "host_permissions": [
    "https://www.google.com/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Открыть Google Region Monitor"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
