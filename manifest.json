{
  "manifest_version": 3,
  "name": "Google Region Monitor",
  "version": "1.4.8",
  "description": "Региональный мониторинг Google с опциональной проверкой ссылок через веб-ChatGPT, профилями поиска и GitHub-синхронизацией.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "activeTab",
    "tabs",
    "downloads",
    "alarms",
    "windows"
  ],
  "host_permissions": [
    "https://www.google.com/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*",
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Открыть Google Region Monitor"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "chatgpt_content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
